/* 二百四 — 游戏页面样式 */

/* ── 全局页面 ── */
.page {
  width: 100vw; height: 100vh;
  overflow: hidden;
  position: relative;
  display: flex; flex-direction: column;
  background: radial-gradient(ellipse 70% 50% at 50% 0%, rgba(91, 155, 213, .08), transparent);
}

/* ── 大厅 ── */
#lobby {
  position: fixed; inset: 0; z-index: 100;
  display: flex; align-items: center; justify-content: center;
  background: var(--bg);
}
.lbox {
  background: var(--s1);
  border: 1px solid var(--b1);
  border-radius: 20rpx;
  padding: 60rpx 64rpx;
  width: 520rpx;
  box-shadow: 0 40rpx 80rpx rgba(0, 0, 0, .6);
}
.logo { text-align: center; margin-bottom: 32rpx; }
.logo .lt { font-size: 72rpx; font-weight: 700; letter-spacing: 6rpx; color: var(--t1); }
.logo .lt em { color: var(--gold); font-style: normal; }
.logo .ls { font-size: 20rpx; color: var(--t2); letter-spacing: 4rpx; margin-top: 8rpx; }
.sep { height: 1px; background: var(--b1); margin: 24rpx 0; }

/* ── 按钮 ── */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: 10rpx; padding: 18rpx 30rpx; border-radius: 14rpx;
  border: none; font-size: 26rpx; font-weight: 600;
  transition: all .14s; white-space: nowrap;
}
.btn:active { transform: scale(.97); opacity: .8; }
.btn:disabled { opacity: .35; }
.btn-primary { background: var(--blue); color: #06101e; }
.btn-ghost { background: var(--s2); color: var(--t1); border: 1px solid var(--b2); }
.btn-gold { background: linear-gradient(135deg, var(--gold2), var(--gold)); color: #1a0e00; }
.btn-red { background: #6e2020; color: #ffd0d0; border: 1px solid rgba(224, 90, 90, .25); }
.btn-block { width: 100%; }
.btn-sm { padding: 10rpx 20rpx; font-size: 22rpx; }

/* ── 游戏主界面 ── */
#game-board {
  flex: 1; display: flex; flex-direction: column;
  position: relative; overflow: hidden;
  height: 100vh;
}

/* ── 顶栏 ── */
#topbar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(180deg, rgba(12, 14, 19, .95), transparent);
  z-index: 30; flex-shrink: 0;
}
.gtitle { font-size: 24rpx; font-weight: 700; letter-spacing: 3rpx; color: var(--t2); }
.chips { display: flex; gap: 10rpx; margin-left: auto; }
.chip {
  background: var(--s1); border: 1px solid var(--b1);
  border-radius: 24rpx; padding: 6rpx 16rpx;
  font-size: 20rpx; color: var(--t2);
  display: flex; align-items: center; gap: 6rpx;
}
.chip .cv { font-weight: 700; font-size: 22rpx; color: var(--t1); }
.cv.pos { color: var(--green) !important; }
.cv.neg { color: var(--red) !important; }
.cv.gold { color: var(--gold) !important; }

/* ── 玩家区域容器 ── */
#middle-area {
  flex: 1; display: flex; flex-direction: column;
  position: relative; overflow: hidden;
  min-height: 0;
}

/* 顶位：AI二 */
#z-top {
  display: flex; flex-direction: column;
  align-items: center; gap: 4rpx;
  flex-shrink: 0; padding-top: 4rpx;
}

/* 中位：左右 + 中央 */
#mid-row {
  flex: 1; display: flex; flex-direction: row;
  position: relative; min-height: 0;
}

/* 左位：AI三 */
#z-left {
  width: 100rpx; flex-shrink: 0;
  display: flex; flex-direction: column;
  align-items: center; gap: 4rpx;
  justify-content: center;
}

/* 中央区域 */
#tcenter {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 10rpx; position: relative;
}

/* 右位：AI一 */
#z-right {
  width: 100rpx; flex-shrink: 0;
  display: flex; flex-direction: column;
  align-items: center; gap: 4rpx;
  justify-content: center;
}

/* ── 底位：你 ── */
#z-bottom {
  flex-shrink: 0;
  display: flex; flex-direction: column;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ── 玩家名牌 ── */
.ptag {
  display: flex; align-items: center; gap: 8rpx;
  background: rgba(19, 22, 31, .92);
  border: 1px solid var(--b1);
  border-radius: 24rpx; padding: 6rpx 16rpx;
  transition: border-color .25s, box-shadow .25s;
}
.ptag.active { border-color: var(--blue2); box-shadow: 0 0 10rpx rgba(91, 155, 213, .2); }
.ptag .pn { font-size: 22rpx; font-weight: 600; white-space: nowrap; }
.ptag .ps { font-size: 20rpx; color: var(--t2); }

.tdot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: var(--blue); box-shadow: 0 0 8rpx var(--blue);
  animation: blink 1s infinite;
}
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }

.hcnt {
  font-size: 18rpx; color: var(--t2);
  background: var(--s2); border: 1px solid var(--b1);
  border-radius: 10rpx; padding: 4rpx 12rpx;
}

.rpill {
  font-size: 16rpx; font-weight: 700;
  padding: 3rpx 10rpx; border-radius: 8rpx;
}
.rp-shout { background: rgba(212, 168, 67, .15); color: var(--gold); border: 1px solid rgba(212, 168, 67, .3); }
.rp-rev { background: rgba(91, 155, 213, .15); color: var(--blue); border: 1px solid rgba(91, 155, 213, .3); }

/* ── 手牌显示 ── */
.hwrap { display: flex; justify-content: center; padding: 8rpx 10rpx 10rpx; }

/* AI 顶部手牌横向 */
#hand-top { display: flex; flex-direction: row; justify-content: center; }
#hand-top .card { margin-left: -16rpx; }
#hand-top .card:first-child { margin-left: 0; }

/* AI 左右手牌纵向 */
#hand-left { display: flex; flex-direction: column; }
#hand-left .card { margin-top: -14rpx; }
#hand-left .card:first-child { margin-top: 0; }

#hand-right { display: flex; flex-direction: column; }
#hand-right .card { margin-top: -14rpx; }
#hand-right .card:first-child { margin-top: 0; }

/* 人类手牌区域 */
#bottom-hand-area {
  display: flex; flex-direction: column;
  align-items: center; width: 100%;
}

/* 手牌横向滚动 */
#hand-scroll {
  width: 100%; white-space: nowrap;
}
#hand-bottom {
  display: flex; flex-direction: row;
  align-items: flex-end; justify-content: flex-start;
  padding: 10rpx 20rpx;
}
#hand-bottom .card { margin-left: -28rpx; }
#hand-bottom .card:first-child { margin-left: 0; }

/* ── 中央信息区 ── */
#statusbar {
  background: rgba(19, 22, 31, .93);
  border: 1px solid var(--b1); border-radius: 12rpx;
  padding: 8rpx 24rpx; font-size: 22rpx; color: var(--t2);
  text-align: center; min-width: 280rpx;
}

/* 出牌展示 grid */
#round-plays {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto auto;
  gap: 8rpx; width: 100%;
}
.rplay { display: flex; flex-direction: column; align-items: center; gap: 4rpx; min-height: 60rpx; padding: 4rpx; }
.rp-top { grid-column: 1/3; grid-row: 1; }
.rp-left { grid-column: 1; grid-row: 2; }
.rp-right { grid-column: 2; grid-row: 2; align-items: flex-end; }
.rp-bottom { grid-column: 1/3; grid-row: 3; }
.rplay-pile { display: flex; justify-content: center; }
.rplay-pile .card { margin-left: -14rpx; }
.rplay-pile .card:first-child { margin-left: 0; }
.rplay-meta { font-size: 18rpx; color: var(--t2); }
.rplay.win-hl .rplay-pile .card {
  box-shadow: 0 0 0 3rpx var(--gold), 0 6rpx 18rpx rgba(212, 168, 67, .4) !important;
}

/* ── 喊牌面板 ── */
#shout-panel {
  position: absolute; top: 60rpx; left: 50%;
  transform: translateX(-50%);
  background: rgba(19, 22, 31, .97);
  border: 1px solid rgba(212, 168, 67, .25);
  border-radius: 18rpx; padding: 16rpx 20rpx;
  display: flex; flex-direction: column;
  align-items: center; gap: 12rpx;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, .5);
  z-index: 50; min-width: 400rpx;
}
.shout-lbl { font-size: 20rpx; color: var(--t2); text-align: center; }
#shout-btns { display: flex; gap: 10rpx; flex-wrap: wrap; justify-content: center; }

/* ── 倒计时 ── */
#countdown-bar {
  position: absolute; bottom: 200rpx; left: 50%;
  transform: translateX(-50%);
  background: rgba(212, 168, 67, .12);
  border: 1px solid rgba(212, 168, 67, .3);
  border-radius: 24rpx; padding: 8rpx 24rpx;
  font-size: 22rpx; color: var(--gold);
  font-weight: 700; z-index: 50;
  text-align: center; pointer-events: none;
}

/* ── 反牌面板 ── */
#rev-panel {
  position: absolute; bottom: 200rpx; left: 50%;
  transform: translateX(-50%);
  background: rgba(19, 22, 31, .97);
  border: 1px solid var(--b1);
  border-radius: 18rpx; padding: 16rpx 20rpx;
  display: flex; align-items: center; gap: 10rpx;
  flex-wrap: wrap; justify-content: center;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, .5);
  z-index: 50;
}
.fl { font-size: 20rpx; color: var(--t2); }

/* ── 操作栏 ── */
#action-bar {
  display: flex; gap: 16rpx; padding: 10rpx 0; z-index: 40;
}

/* ── Toast ── */
#toasts {
  position: fixed; top: 80rpx; left: 50%;
  transform: translateX(-50%);
  display: flex; flex-direction: column;
  gap: 8rpx; align-items: center;
  z-index: 200; pointer-events: none;
}
.toast {
  background: var(--s1); border: 1px solid var(--b1);
  border-radius: 20rpx; padding: 8rpx 20rpx;
  font-size: 22rpx; box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, .4);
  animation: tsin .26s cubic-bezier(.34, 1.56, .64, 1);
}
.toast.out { animation: tsout .2s forwards; }
.tgold { border-color: rgba(212, 168, 67, .4); color: var(--gold); }
.tred { border-color: rgba(224, 90, 90, .4); color: var(--red); }
.tgreen { border-color: rgba(82, 194, 122, .3); color: var(--green); }
@keyframes tsin { from { opacity: 0; transform: translateY(-10rpx) scale(.92); } to { opacity: 1; transform: none; } }
@keyframes tsout { to { opacity: 0; transform: translateY(-10rpx) scale(.92); } }

/* ── 结算界面 ── */
#endlay {
  position: fixed; inset: 0; z-index: 300;
  background: rgba(0, 0, 0, .82);
  display: flex; align-items: center; justify-content: center;
}
.ebox {
  background: var(--s1); border: 1px solid var(--b1);
  border-radius: 28rpx; padding: 48rpx 56rpx;
  width: 560rpx; text-align: center;
  animation: popIn .38s cubic-bezier(.34, 1.56, .64, 1);
  box-shadow: 0 40rpx 80rpx rgba(0, 0, 0, .7);
}
@keyframes popIn { from { opacity: 0; transform: scale(.76); } to { opacity: 1; transform: none; } }
.eemoji { font-size: 72rpx; margin-bottom: 8rpx; }
.etitle { font-size: 38rpx; font-weight: 700; margin-bottom: 6rpx; }
.etitle.win { color: var(--gold); }
.etitle.lose { color: var(--red); }
.etitle.tie { color: var(--blue); }
.stbl { width: 100%; border-collapse: collapse; margin: 20rpx 0; }
.stbl th { font-size: 18rpx; color: var(--t3); text-transform: uppercase; letter-spacing: 2rpx; padding: 8rpx; border-bottom: 1px solid var(--b1); }
.stbl td { font-size: 22rpx; padding: 10rpx 8rpx; border-bottom: 1px solid var(--b1); color: var(--t2); }
.stbl .you { color: var(--t1); font-weight: 700; }
.pos-color { color: var(--green); }
.neg-color { color: var(--red); }
.eacts { display: flex; gap: 16rpx; justify-content: center; margin-top: 10rpx; }

/* ── 抖动动画 ── */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-8rpx); }
  40% { transform: translateX(8rpx); }
  60% { transform: translateX(-6rpx); }
  80% { transform: translateX(6rpx); }
}
.shake { animation: shake .28s; }

/* ── 屏幕适配 ── */
/* 小屏设备（iPhone SE 320px） */
@media screen and (max-width: 350px) {
  .logo .lt { font-size: 56rpx; }
  .lbox { width: 460rpx; padding: 40rpx 32rpx; }
  #z-left, #z-right { width: 80rpx; }
  .ptag .pn { font-size: 18rpx; }
}

/* ══════════════════════════════════════════
   横屏布局 (.landscape)
   ══════════════════════════════════════════ */

/* ── 顶栏 ── */
.landscape #topbar {
  padding: 2rpx 16rpx; height: 24rpx;
}
.landscape .gtitle { font-size: 18rpx; letter-spacing: 2rpx; }
.landscape .chips { gap: 6rpx; }
.landscape .chip { font-size: 16rpx; padding: 2rpx 10rpx; border-radius: 16rpx; }
.landscape .chip .cv { font-size: 18rpx; }

/* ── 游戏面板 ── */
.landscape#game-board {
  flex: 1; display: flex; flex-direction: column;
  overflow: hidden;
}

/* ── middle-area ── */
.landscape #middle-area {
  display: flex; flex-direction: column;
  flex: 1; min-height: 0;
}

/* ── AI 行 ── */
#ai-row {
  display: flex; flex-direction: row;
  justify-content: space-around; align-items: center;
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  height: 44rpx;
}
.ai-slot {
  display: flex; flex-direction: row;
  align-items: center; gap: 6rpx;
}
.ai-slot .ptag {
  padding: 2rpx 8rpx; gap: 4rpx;
  border-radius: 14rpx;
}
.ai-slot .pn { font-size: 16rpx; }
.ai-slot .ps { font-size: 14rpx; }
.ai-slot .hcnt { font-size: 14rpx; padding: 1rpx 8rpx; }
.ai-slot .tdot { width: 8rpx; height: 8rpx; }
.ai-slot .rpill { font-size: 12rpx; padding: 1rpx 6rpx; }

.ai-cards {
  display: flex; flex-direction: row;
}
.ai-cards .card { margin-left: -28rpx; }
.ai-cards .card:first-child { margin-left: 0; }

/* ── 中央区 ── */
.landscape #tcenter {
  flex: 1; min-height: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 4rpx; position: relative;
}
.landscape #statusbar {
  font-size: 18rpx; padding: 4rpx 16rpx;
  min-width: auto; border-radius: 10rpx;
}
.landscape #round-plays {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto;
  gap: 4rpx; width: 300rpx;
}
.landscape .rp-top { grid-column: 1; grid-row: 1; }
.landscape .rp-right { grid-column: 2; grid-row: 1; }
.landscape .rp-left { grid-column: 1; grid-row: 2; }
.landscape .rp-bottom { grid-column: 2; grid-row: 2; }
.landscape .rplay { min-height: 50rpx; padding: 1rpx; gap: 1rpx; }
.landscape .rplay-pile .card { margin-left: -8rpx; }
.landscape .rplay-meta { font-size: 14rpx; }
.landscape .rplay.win-hl .rplay-pile .card {
  box-shadow: 0 0 0 2rpx var(--gold), 0 4rpx 12rpx rgba(212, 168, 67, .4) !important;
}

/* ── 面板 ── */
.landscape #shout-panel {
  top: 30rpx; padding: 10rpx 16rpx;
  min-width: 320rpx; gap: 8rpx;
}
.landscape .shout-lbl { font-size: 18rpx; }
.landscape #countdown-bar {
  bottom: auto; top: 8rpx;
  font-size: 18rpx; padding: 4rpx 16rpx;
}
.landscape #rev-panel {
  bottom: auto; top: 8rpx;
  padding: 10rpx 16rpx; gap: 8rpx;
}

/* ── 人类信息栏 ── */
#z-bottom-info {
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  flex-shrink: 0;
  padding: 2rpx 20rpx;
  height: 26rpx;
}
#z-bottom-info .ptag {
  padding: 2rpx 12rpx; gap: 6rpx;
}
#z-bottom-info .pn { font-size: 16rpx; }
#z-bottom-info .ps { font-size: 14rpx; }
#z-bottom-info .tdot { width: 8rpx; height: 8rpx; }
#z-bottom-info .rpill { font-size: 12rpx; padding: 1rpx 6rpx; }

/* ── 操作栏 ── */
.landscape #action-bar {
  padding: 0; gap: 8rpx;
}
.landscape #action-bar .btn {
  padding: 6rpx 18rpx; font-size: 20rpx;
  border-radius: 10rpx;
}

/* ── 手牌 ── */
.landscape #hand-scroll {
  flex-shrink: 0;
  height: 150rpx;
}
.landscape #hand-bottom {
  padding: 10rpx 16rpx;
  align-items: flex-end;
}
.landscape #hand-bottom .card {
  margin-left: -20rpx;
}
.landscape #hand-bottom .card:first-child {
  margin-left: 0;
}
.landscape #hand-bottom .card.sel {
  transform: translateY(-24rpx) !important;
}

/* ── Toast ── */
.landscape #toasts { top: 40rpx; }
.landscape .toast { font-size: 20rpx; padding: 6rpx 16rpx; }

/* ── 结算界面 ── */
.landscape .ebox {
  width: 480rpx; padding: 28rpx 40rpx;
  border-radius: 20rpx;
}
.landscape .eemoji { font-size: 48rpx; }
.landscape .etitle { font-size: 28rpx; }
.landscape .stbl th { font-size: 16rpx; padding: 6rpx; }
.landscape .stbl td { font-size: 20rpx; padding: 8rpx 6rpx; }
.landscape .eacts { gap: 10rpx; }
.landscape .eacts .btn { padding: 12rpx 24rpx; font-size: 22rpx; }

/* ── 大厅 ── */
.landscape .lbox { padding: 32rpx 40rpx; width: 400rpx; }
.landscape .logo .lt { font-size: 48rpx; }
